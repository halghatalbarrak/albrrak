// منصة إدارة حلقات التحفيظ — المخطط منقول من DESIGN.md §١٣ (نفس القيم والترتيب).
// ملاحظة تنسيق: DESIGN كتب بعض الـenums مضغوطة في سطر واحد؛ Prisma يشترط قيمة
// واحدة لكل سطر — فوُسّعت هنا بلا أي تغيير في القيم أو ترتيبها.
// م٠: تعريفات الجداول والأنواع فقط. لا منطق، لا بذور، لا شاشات (القلب يُبنى في م١+).
// كل تغيير لاحق = ترحيل مرقّم جديد (قاعدة العمل ٣: Prisma مصدر الحقيقة الوحيد).

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ═══════════════ الأساس ═══════════════

enum Role {
  TECH_ADMIN
  SUPER_ADMIN
  CIRCLE_MANAGER
  REGISTRAR
  TEACHER
  RECITER
  ARIF
  STUDENT
  GUARDIAN
  SELLER
}

enum Gender {
  MALE
  FEMALE
}

model User {
  id          String    @id @default(cuid())
  authId      String?   @unique // auth.users.id — فارغٌ لمن دون ١٣ (يُنفِذ م٤ بنيةً)
  nameAsInId  String // كما في الهوية — تحقّق عند الإدخال
  nationalId  String?   @unique // ⚠️ م٥ — مشفَّر على مستوى التطبيق
  nationality String?
  birthDate   DateTime? // ميلادي — العمر محسوب لا مُدخَل
  gender      Gender
  phone       String? // يبدأ بـ 966
  email       String?   @unique
  roles       Role[] // صفات لا كيانات
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  student              Student?
  teaching             CircleTeacher[]
  guardianOf           GuardianLink[]        @relation("Guardian")
  nationalIdAccessLogs NationalIdAccessLog[]
}

// سجل الاطّلاع على رقم الهوية — م٥
model NationalIdAccessLog {
  id        String   @id @default(cuid())
  subjectId String // صاحب الهوية
  viewerId  String // من اطّلع
  viewer    User     @relation(fields: [viewerId], references: [id])
  reason    String?
  viewedAt  DateTime @default(now())

  @@index([subjectId])
}

// سجل الاطّلاع على جهة اتصال الطوارئ — أخفّ من سجل الهوية (بلا سبب/علاقة User).
// يُكتب سطرٌ كلّما كشف معلّمٌ جوالَ طوارئ طالبٍ من طلابه.
model EmergencyAccessLog {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  viewerId  String // معرّف المعلّم المُطّلِع
  viewedAt  DateTime @default(now())

  @@index([studentId])
}

// ═══════════════ الحلقات ═══════════════

enum TimeSlot {
  ASR
  MAGHRIB
}

enum ProgramKey {
  QAIDAH_MADANIYYAH
  MARAQI
  WEEKLY
  MUDDAKIR
}

model Program {
  id       String     @id @default(cuid())
  key      ProgramKey @unique
  nameAr   String
  circles  Circle[]
  stages   Stage[]
  tracks   Track[]
  settings Setting[]
  enrollments Enrollment[]
  // ق٤: مسار الانتقال (القاعدة ← مراقي ← المُدَّكِر) — يُدار من الإدارة، لا محفورٌ في المنطق.
  nextProgramId String?
  nextProgram   Program?  @relation("ProgramNext", fields: [nextProgramId], references: [id])
  nextOf        Program[] @relation("ProgramNext")
  // ق٥: المسار الافتراضيّ للمنتقلين إلى هذا البرنامج (يبدؤون من الفاتحة به).
  defaultTrackForIncomingId String?
  defaultTrackForIncoming   Track?  @relation("ProgramDefaultTrack", fields: [defaultTrackForIncomingId], references: [id])
}

model Circle {
  id          String          @id @default(cuid())
  nameAr      String
  timeSlot    TimeSlot
  location    String?
  gender      Gender // العزل لاحقاً — الحقل الآن
  programId   String
  program     Program         @relation(fields: [programId], references: [id])
  teachers    CircleTeacher[] // متعدد لمتعدد
  enrollments Enrollment[]
}

model CircleTeacher {
  circleId  String
  teacherId String
  circle    Circle    @relation(fields: [circleId], references: [id])
  teacher   User      @relation(fields: [teacherId], references: [id])
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@id([circleId, teacherId])
}

// ═══════════════ الطالب ═══════════════

enum StudentState {
  APPLIED
  PENDING_ACCEPTANCE
  WAITLISTED
  REJECTED
  AWAITING_READING_TEST
  IN_QAIDAH
  AWAITING_PACE_TEST
  PACE_RETEST_SCHEDULED
  IN_MARAQI
  COMPLETED
  GRADUATED
  WITHDRAWN
}

model Student {
  id                 String       @id @default(cuid())
  userId             String       @unique
  user               User         @relation(fields: [userId], references: [id])
  state              StudentState @default(APPLIED)
  schoolStage        String? // المرحلة الدراسية — للجهة
  priorHifzAmount    String? // مقدار الحفظ — للجهة (الصيغة؟)
  priorHifzLocations Json? // مواضع الحفظ — لاختيار المقطع

  // ق٥: انتقالٌ برنامجيٌّ مؤجَّلٌ بالتاريخ (كسولٌ يُطبَّق أوّل قراءةٍ في يومٍ ≥ pendingFrom).
  // يُخزَّن عند تخرّج القاعدة؛ يُطبَّقه المحلّل الواحد (resolveStudentProgram) بأمانٍ من السباق.
  pendingProgramId String?
  pendingTrackId   String?
  pendingFrom      DateTime? @db.Date

  // جهة اتصال الطوارئ — تُستعمل حين لا يردّ الولي. ليست بياناً إدارياً:
  // يراها معلّم الطالب فقط، بضغطة صريحة، وبسطرٍ في EmergencyAccessLog.
  emergencyName       String?
  emergencyPhone      String?
  emergencyRelationId String?
  emergencyRelation   GuardianRelation? @relation("EmergencyRel", fields: [emergencyRelationId], references: [id])

  enrollments         Enrollment[]
  guardians           GuardianLink[]       @relation("Student")
  progress            StageProgress[]
  sessions            DailySession[]
  attendance          Attendance[]
  hasads              Hasad[]
  trackAssignments    TrackAssignment[]
  certificates        Certificate[]
  emergencyAccessLogs EmergencyAccessLog[]
}

model Enrollment {
  id        String    @id @default(cuid())
  studentId String
  circleId  String
  student   Student   @relation(fields: [studentId], references: [id])
  circle    Circle    @relation(fields: [circleId], references: [id])
  // ق١: البرنامج صفةٌ في القيد (لا في الحلقة). مبذورٌ من برنامج الحلقة للقيود القائمة.
  programId String?
  program   Program?  @relation(fields: [programId], references: [id])
  startedAt DateTime  @default(now())
  endedAt   DateTime? // النشط = null
  // ⚠️ قيد: انتساب نشط واحد لكل طالب — partial unique index (يُضاف في م١ مع منطق الأعمار)

  @@index([studentId, endedAt])
  @@index([programId])
}

enum GuardianLinkStatus {
  ACTIVE
  UNLINK_REQUESTED
  UNLINKED
}

model GuardianLink {
  id                 String             @id @default(cuid())
  guardianId         String
  studentId          String
  guardian           User               @relation("Guardian", fields: [guardianId], references: [id])
  student            Student            @relation("Student", fields: [studentId], references: [id])
  status             GuardianLinkStatus @default(ACTIVE)
  // صفة الولي تجاه الطالب (أب/أخ/عم…) — قيمة من جدول GuardianRelation لا ثابت.
  relationId         String?
  relation           GuardianRelation?  @relation("GuardianRel", fields: [relationId], references: [id])
  // طلب فكّ الربط — لا يظهر للولي إطلاقاً
  unlinkReason       String?
  unlinkDecidedBy    String?
  unlinkDecisionNote String?

  @@unique([guardianId, studentId])
}

// ═══════════════ محرّك الاعتمادات ═══════════════

enum ApprovalKind {
  PLACEMENT_DECISION
  MILESTONE_TRANSITION
  SUBSTAGE_TRANSITION
  STAGE_TRANSITION
  GRADUATION
  ABSENCE_EXCUSE
  TRACK_PROMOTION
  TRACK_DEMOTION
  GUARDIAN_UNLINK
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Approval {
  id           String         @id @default(cuid())
  kind         ApprovalKind
  subjectType  String // Hasad | Attendance | ...
  subjectId    String
  proposedBy   String
  proposedAt   DateTime       @default(now())
  status       ApprovalStatus @default(PENDING)
  decidedBy    String?
  decidedAt    DateTime?
  decisionNote String? // إلزامي عند الرفض
  payload      Json? // بيان القرار المعروض على المدير

  @@index([status, kind])
  @@index([proposedAt]) // عمر الطلب
}

// التفويض — على مستوى الأدوار لا الأفراد
model PermissionDelegation {
  id         String    @id @default(cuid())
  capability String // ABSENCE_EXCUSE | ...
  holderRole Role
  grantedBy  String
  grantedAt  DateTime  @default(now())
  revokedAt  DateTime?

  @@index([capability, revokedAt])
}

// ═══════════════ المراحل — عام ═══════════════

enum StageKind {
  CHAPTER
  MILESTONE
  MAIN_STAGE
  SUB_STAGE
  LESSON // القاعدة المدنية: الدرس (وحدة الجلسة) — ابنٌ للباب (CHAPTER) عبر parentId
}

model Stage {
  id           String          @id @default(cuid())
  programId    String
  program      Program         @relation(fields: [programId], references: [id])
  kind         StageKind
  ordinal      Int
  nameAr       String
  parentId     String?
  parent       Stage?          @relation("StageTree", fields: [parentId], references: [id])
  children     Stage[]         @relation("StageTree")
  weight       Int? // الوزن — الأبواب ليست متساوية
  objectives   Json? // أهداف الباب من صفحة «للمعلم»
  teacherNotes String? // إرشادات المؤلف — تُعرض في المنصة
  // لمراقي: المرحلة الفرعية = حزب. الرقم للإدارة (الحصاد م٤ج) — لا يُعرض للطالب (§٨٫٢).
  hizbNumber   Int?
  // لمراقي: حدود الحزب
  fromSurah    Int?
  fromAyah     Int?
  toSurah      Int?
  toAyah       Int?
  progress     StageProgress[]

  @@unique([programId, kind, ordinal])
}

enum ProgressState {
  NOT_STARTED
  IN_PROGRESS
  AWAITING_HASAD
  REPAIRING
  COMPLETED
}

model StageProgress {
  id              String        @id @default(cuid())
  studentId       String
  stageId         String
  student         Student       @relation(fields: [studentId], references: [id])
  stage           Stage         @relation(fields: [stageId], references: [id])
  state           ProgressState @default(NOT_STARTED)
  startedAt       DateTime?
  completedAt     DateTime?
  attendanceDays  Int           @default(0) // ⭐ القياس بأيام الحضور
  readyDeclaredAt DateTime? // إعلان الجاهزية
  failureCount    Int           @default(0) // للضربتين
  // ق٢: مصدر الإتقان — PLACEMENT (تسكينٌ، بلا نقاط) مقابل null (إتقانٌ فعليّ في جلسة).
  source          PlacementSource?

  @@unique([studentId, stageId])
}

// ق٢: يميّز الإتقان المسكَّن عن الفعليّ (تُصنع القيمة PLACEMENT عند التسكين فقط).
enum PlacementSource {
  PLACEMENT
}

// ق٣: محفوظ مراقي المسكَّن — موضع الوصول بالترتيب + نطاقات خارج الترتيب. تقرؤه وجهة اليوم.
// جدولٌ متأخّرٌ بلا FK (نمط الترحيلات الآمن، كـTrackUnit).
model MaraqiPlacement {
  id           String   @id @default(cuid())
  studentId    String   @unique
  reachedSurah Int? // آخر سورةٍ بلغها بالترتيب (الجبهة المسكَّنة)
  reachedAyah  Int? // وآيتها
  outOfOrder   Json? // [{fromSurah,fromAyah,toSurah,toAyah}] محفوظٌ قبل بلوغه
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ق٦: تاريخ برامج الطالب (دخل/خرج/السبب/الفاعل). جدولٌ متأخّرٌ بلا FK.
enum ProgramHistoryReason {
  ASSIGNMENT // إسنادٌ أوّليّ
  READING_TEST // اختبار قراءة (تحديد)
  GRADUATION // تخرّجٌ وانتقال
  CHANGE // تغييرٌ إداريّ
}

model ProgramEnrollmentHistory {
  id        String               @id @default(cuid())
  studentId String
  programId String
  enteredAt DateTime             @default(now())
  exitedAt  DateTime?
  reason    ProgramHistoryReason
  actorId   String?

  @@index([studentId])
}

// ═══════════════ المسارات ═══════════════

model Track {
  id          String            @id @default(cuid())
  programId   String
  program     Program           @relation(fields: [programId], references: [id])
  nameAr      String // «نصف صفحة»
  linesPerDay Float // ٧٫٥ — للترتيب والحساب
  ordinal     Int
  isActive    Boolean           @default(true)
  // منهج الترسيخ والمراجعة لكلّ مسار (يضبطه المدير) — لا ثوابت في الكود (مراقي ٢):
  tarseekhUnits     Int @default(10) // الترسيخ = عدد الوحدات السابقة لوحدة اليوم في ترتيب المسار
  reviewDaysPerWeek Int @default(5) // المراجعة = كلّ المحفوظ (قبل نافذة الترسيخ) مقسومًا على أيّام الأسبوع
  assignments TrackAssignment[]
  defaultForPrograms Program[]  @relation("ProgramDefaultTrack")

  @@unique([programId, ordinal])
}

model TrackAssignment {
  id        String    @id @default(cuid())
  studentId String
  trackId   String
  student   Student   @relation(fields: [studentId], references: [id])
  track     Track     @relation(fields: [trackId], references: [id])
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  reason    String? // PACE_TEST | PROMOTION | DEMOTION

  @@index([studentId, endedAt])
}

model PaceTest {
  id              String    @id @default(cuid())
  studentId       String
  passageId       String? // من البنك — اختياريّ حتى يُبنى بنك المقاطع (§٨٫٥)
  administeredBy  String // المُختبِر — ليس معلمه (م١)
  startedAt       DateTime
  endedAt         DateTime?
  linesMemorized  Float?
  assignedTrackId String?
}

model PacePassage {
  id        String  @id @default(cuid())
  nameAr    String
  fromSurah Int
  fromAyah  Int
  toSurah   Int
  toAyah    Int
  isActive  Boolean @default(true)
  // المعايرة بالبيانات: متوسط النتائج
}

// حدود الأحزاب الستين (§٨٫٢) — مرجعٌ قرآنيّ خام يُبذر من hizb_boundaries.json الموقَّع
// (مصحف المدينة، توقيع محمد). لا يُكتب حدٌّ من الذاكرة. المرحلة الفرعية تُشتقّ منه.
model HizbBoundary {
  hizb          Int    @id // ١..٦٠
  juz           Int
  startSurahNum Int
  startSurah    String
  startAyah     Int
  endSurahNum   Int
  endSurah      String
  endAyah       Int
}

// خريطة أوجه مصحف المدينة (V1، ١٤٠٥هـ، ٦٠٤ صفحة) — الوجه = صفحة (الحكم ٧). مرجعٌ ثابت
// من QUL: صفحة ← أول آية/آخر آية. أوجه كل حزب تُشتقّ بالتقاطع مع HizbBoundary.
model MushafFace {
  page      Int @id // ١..٦٠٤
  fromSurah Int
  fromAyah  Int
  toSurah   Int
  toAyah    Int
}

// خريطة السطر↔الآية (البند ٢): صفٌّ لكل (وجه، سطر) بحدود آياته. مستنبَطةٌ من مضلّعات مصحف
// المدينة (كل مقطع SVG = سطر)، تُبذَر بسكربتٍ منفصلٍ لا بالترحيل. طبقة قراءةٍ فقط — أساس
// وحدات المسارات ووجهة اليوم. جدولٌ مستقلٌّ بلا FK (نمط الجداول المتأخّرة).
model MushafLine {
  page       Int // ١..٦٠٤
  lineNo     Int // ١..١٥ (أقلّ في الصفحتين المزخرفتين ١، ٢)
  startSurah Int // أوّل آيةٍ في السطر (يمين — بداية القراءة)
  startAyah  Int
  endSurah   Int // آخر آيةٍ في السطر (يسار)
  endAyah    Int

  @@id([page, lineNo])
  @@index([startSurah, startAyah])
  @@index([endSurah, endAyah])
}

// وحدات المسارات المُجهَّزة (البند ٢، المرحلة ٣): القرآن مقسّمٌ مسبقًا لكل مسارٍ بمقداره
// (linesPerDay) إلى وحداتٍ بحدود آيات، مرقّمةً بترتيب حفظ مراقي (١ = أول وحدةٍ من الفاتحة/الناس،
// تصاعدًا نحو البقرة). تُبذَر بسكربتٍ منفصل، وقابلةٌ لتعديل الإدارة (حدود وحدة). بلا FK (نمط
// الجداول المتأخّرة) — trackId مرجعٌ لـTrack. طبقة قراءةٍ فقط للجلسة.
model TrackUnit {
  id         String @id @default(cuid())
  trackId    String // المسار (Track)
  unitNo     Int // ترتيب الحفظ (١ = الأولى المحفوظة، تنازليّ بالسور)
  startSurah Int
  startAyah  Int
  endSurah   Int
  endAyah    Int

  @@unique([trackId, unitNo])
  @@index([trackId, startSurah, startAyah])
}

// ═══════════════ الجلسة اليومية — مراقي فقط ═══════════════

model DailySession {
  id        String   @id @default(cuid())
  studentId String
  circleId  String
  student   Student  @relation(fields: [studentId], references: [id])
  date      DateTime @db.Date

  // الحفظ — المعلم وحده (م٢)
  hifzFromSurah Int?
  hifzFromAyah  Int?
  hifzToSurah   Int?
  hifzToAyah    Int?
  hifzAttempts  Int? // ⭐ مقياس الاعتياد
  hifzMastered  Boolean?
  hifzTeacherId String? // لا بد أن يكون معلم الطالب
  // الحكم ٥ (الترميم): خطآن في مراجعة هذا المقطع ⟵ يعود حفظًا جديدًا (يخرج من الراسخ).
  repairedAt    DateTime?

  // الترسيخ — تمّ/لم يتم فقط
  tarseekhDone       Boolean?
  tarseekhListenerId String?

  // المراجعة — الحكم ٤ الموسّع: المقدار المُسمَّع اليوم (مقاطع)، يتراكم أسبوعيًّا.
  murajaahDone       Boolean?
  murajaahCount      Int?
  murajaahListenerId String?

  tajweedFlagged Boolean @default(false) // زرّ العريف: «أشِر للمعلم»

  @@unique([studentId, date])
  @@index([circleId, date])
}

// حالة الجلسة «مؤجَّل» (مشترَكة بين مراقي والقاعدة — MARAQI_RULES/QAIDAH_RULES): الطالب حاضرٌ
// جاهزٌ لم يُسمَّع/يُقيَّم لضيق الوقت. سطرٌ محايدٌ إيجابيّ: **لا يحرّك الموضع، ولا يمنح/يخصم**.
// مرّةً لليوم (@@unique) — إعادة التسجيل idempotent. بلا FK (نمط الجداول المتأخّرة الآمن).
model DeferredSession {
  id         String   @id @default(cuid())
  studentId  String
  date       DateTime @db.Date
  recordedBy String
  createdAt  DateTime @default(now())

  @@unique([studentId, date])
  @@index([studentId])
}

// نتيجة تقييم درس القاعدة اليوميّ (م ج). DEFERRED = مؤجَّل (حاضرٌ لم يُقيَّم لضيق الوقت).
enum QaidahEvalResult {
  MASTERED
  NOT_MASTERED
  DEFERRED
}

// تقييم درس القاعدة المدنية اليوميّ (م ج — الشاشة الموحّدة): صفٌّ واحدٌ لكلّ (طالب، يوم) يفرض
// «تقييمًا واحدًا في اليوم» (upsert)، ويتيح عكس أثر السابق في اليوم نفسه (ق٥)، وعدّاد
// التأجيلات المتتالية (ق٦)، وقفل التخرّج (ق٧). جدولٌ متأخّرٌ بلا FK (نمط DeferredSession).
model QaidahDailyEval {
  id            String           @id @default(cuid())
  studentId     String
  date          DateTime         @db.Date
  result        QaidahEvalResult
  lessonId      String // درس Stage المُقيَّم (لقطةٌ وقت التقييم)
  evaluatedById String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([studentId, date])
  @@index([studentId])
}

// ═══════════════ الحضور ═══════════════

enum AttendanceStatus {
  PRESENT
  ABSENT_UNEXCUSED
  ABSENT_EXCUSED
  LATE
  PRE_EXCUSED
  LEFT_EARLY // مُتقاعَدة (المرحلة أ): تُرحَّل سجلّاتها إلى PRESENT، ولا تُعرَض للتأشير
  LEFT_NO_PERMISSION // «خرج بدون إذن» (شاشة التشغيل الموحّدة، م أ) — لا يُحتسب حضورًا
}

model Attendance {
  id               String           @id @default(cuid())
  studentId        String
  circleId         String
  student          Student          @relation(fields: [studentId], references: [id])
  date             DateTime         @db.Date
  status           AttendanceStatus @default(PRESENT) // الافتراض: حاضر
  recordedBy       String
  note             String? // م٢ — سبب العذر/الاستئذان أو تعليق المعلم
  excuseAcceptedBy String? // من قَبِل العذر — بأي تفويض
  excuseAcceptedAt DateTime?

  @@unique([studentId, date])
  @@index([circleId, date])
}

// سجلّ أخطاء المراجعة (الحكم ٥): سطرٌ لكل خطأٍ على مقطعٍ (جلسة حفظ) — بتاريخه ومَن رصده.
// العدّ تراكميٌّ داخل نافذة آخر ١٠ جلسات حفظ؛ بلوغ خطأين ⟵ ترميم (يُصفَّر السجلّ للمقطع).
model ReviewError {
  id         String   @id @default(cuid())
  sessionId  String // جلسة الحفظ (المقطع) التي رُوجِعت
  recordedBy String // من رصد (الحكم ٦: المعلّم أو المُسنَد)
  date       DateTime @db.Date // يوم المراجعة
  createdAt  DateTime @default(now())

  @@index([sessionId])
}

// تعيين العريف (الحكم ٨): المعلّم يعيّن طالباً من حلقته عريفاً — يُسمِّع الترسيخ/المراجعة
// بإسناده ومسؤوليته. لا يُسمِّع الحفظ الجديد ولا يختبر. النشط = endedAt IS NULL.
model ArifAppointment {
  id          String    @id @default(cuid())
  circleId    String // الحلقة التي عُيّن فيها
  arifUserId  String // العريف = مستخدم (طالبٌ منتسبٌ للحلقة)
  appointedBy String // المعلّم الذي عيّنه (مسؤوليته)
  startedAt   DateTime  @default(now())
  endedAt     DateTime?

  @@index([circleId, endedAt])
  @@index([arifUserId, endedAt])
}

// ═══════════════ الحصاد ═══════════════

enum HasadResult {
  EXCELLENT
  PASS
  FAIL
}

model Hasad {
  id          String           @id @default(cuid())
  studentId   String
  stageId     String // فرعية أو أصلية
  student     Student          @relation(fields: [studentId], references: [id])
  reciterId   String // م١ + م٣ — يُتحقَّق في الخادم
  scheduledAt DateTime?
  conductedAt DateTime?
  fromSurah   Int
  fromAyah    Int
  toSurah     Int
  toAyah      Int
  result      HasadResult?
  attemptNo   Int              @default(1) // الضربتان
  pageErrors  HasadPageError[]

  @@index([studentId, stageId])
}

enum HasadErrorType {
  WORD
  LETTER
  FORGOTTEN_AYAH
}

// التردّد (الحكم ٧): يُنسب للوجه (صفحة). ثلاثٌ في الوجه نفسه = خطأ (يُحسب وقت التقدير).
// جدولٌ مستقلٌّ بلا FK (كنمط ArifAppointment) — تفاديًا لترتيب الترحيلات المعجميّ.
model HasadHesitation {
  id      String @id @default(cuid())
  hasadId String
  faceNo  Int // الوجه (= صفحة مصحف المدينة) الذي وقع فيه التردّد

  @@index([hasadId])
}

// ═══════════════ اختبار المرحلة الأصلية (الحكم ٧) ═══════════════

enum StageExamStatus {
  IN_PROGRESS
  PASSED
  FAILED
}

// اختبار المرحلة الأصلية: نطاقُه كامل المحفوظ منذ أول يوم، بمُختبِرٍ محايد (الحكم ٦).
// عدد الجلسات بعدد الأحزاب (≤٢٠→١، ٢١–٤٠→٢، >٤٠→٣)، أيامٌ متتالية بالتقويم (شاملةً العطلة).
// تجميع: رسوب حزبٍ = رسوب الكلّ، والمرتبة النهائية = أدنى مرتبة. جدولٌ مستقلٌّ بلا FK.
model StageExam {
  id              String          @id @default(cuid())
  studentId       String
  mainStageId     String // المرحلة الأصلية التي أتمّها الطالب
  examinerId      String // المُختبِر المحايد (ليس معلمه)
  hizbCount       Int // عدد الأحزاب المُختبَرة (كامل المحفوظ)
  plannedSessions Int // ١..٣ بحسب عدد الأحزاب
  startedOn       DateTime        @db.Date
  status          StageExamStatus
  finalRank       HasadResult? // الأدنى بين الأحزاب (عند الاكتمال)
  createdAt       DateTime        @default(now())

  @@index([studentId])
}

// إجازة اختبار المرحلة (البند ١): تبدأ تلقائيًّا بإتمام كل أحزاب المرحلة الأصلية — توقّفٌ تامّ
// ٧ أيّام تقويميّة. للمعلّم تأجيلٌ واحد (+٧)، والمتكرّر بيد الإدارة (+٧ لكلٍّ). المُحتسب
// effectiveEndsOn = base + التأجيلات. جدولٌ مستقلٌّ بلا FK (نمط StageExam/DeferredSession)
// تفاديًا لترتيب الترحيلات المعجميّ. لا حالة ProgressState جديدة — «في إجازة» تُشتقّ من هذا السطر.
model StageExamLeave {
  id                  String   @id @default(cuid())
  studentId           String
  mainStageId         String // المرحلة الأصلية التي أُتمّت
  startedOn           DateTime @db.Date // يوم إكمال آخر حزب
  baseEndsOn          DateTime @db.Date // بعد ٧ أيّام تقويميّة
  teacherDeferredOnce Boolean  @default(false) // تأجيل المعلّم — مرّةً واحدة
  adminDeferrals      Int      @default(0) // تأجيلات الإدارة — بلا حدّ
  effectiveEndsOn     DateTime @db.Date // المُحتسب = base + التأجيلات
  createdAt           DateTime @default(now())

  @@unique([studentId, mainStageId])
  @@index([effectiveEndsOn])
  @@index([studentId])
}

model HasadPageError {
  id        String         @id @default(cuid())
  hasadId   String
  hasad     Hasad          @relation(fields: [hasadId], references: [id])
  pageNo    Int // مصحف المدينة
  errorType HasadErrorType
  surah     Int?
  ayah      Int?

  @@index([pageNo]) // خريطة مواضع الضعف
}

// ═══════════════ الشهادات ═══════════════

enum CertificateTemplate {
  QAIDAH
  SUB_STAGE
  MAIN_STAGE
  KHATM
  MUDDAKIR_STAGE // إتمام مرحلةٍ من المُدَّكِر (§١/§٧)
  MUDDAKIR_KHATM // إتمام حفظ القرآن في المُدَّكِر — شهادة البرنامج (§١)
  MUDDAKIR_TATHBIT // إتمام مرحلة التثبيت (§١٢) — بعد اعتماد المشرف
}

model Certificate {
  id          String              @id @default(cuid())
  studentId   String
  student     Student             @relation(fields: [studentId], references: [id])
  template    CertificateTemplate
  isExcellent Boolean             @default(false) // وسام لا قالب
  stageId     String?
  issuedAt    DateTime            @default(now())
  verifyToken String              @unique // ⚠️ عشوائي غير متسلسل
  imageUrl    String?
  revokedAt   DateTime? // الفكرة ١٠: إبطالٌ لاحقٌ إن لزم — التحقّق يُظهر «مُبطَلة»
}

// ═══════════════ الإعدادات ═══════════════

model Setting {
  id        String   @id @default(cuid())
  programId String?
  program   Program? @relation(fields: [programId], references: [id])
  key       String
  value     Json

  @@unique([programId, key])
}

// ═══════════════ التسجيل والقيد (م١) ═══════════════
// جدولان يملؤهما المدير — لا ثوابت في الكود. القيم تُخزَّن قانونيًّا،
// والمطابقة مع صيغة الجهة الإشرافية تقع في طبقة التصدير لاحقًا.

model Nationality {
  id           String        @id @default(cuid())
  nameAr       String        @unique
  isActive     Boolean       @default(true)
  ordinal      Int           @default(0)
  applications Application[]
}

model SchoolStage {
  id           String        @id @default(cuid())
  nameAr       String        @unique
  ordinal      Int
  isActive     Boolean       @default(true)
  applications Application[]
}

// صفة القرابة (أب/أخ/عم/خال/جد/وصي/غير ذلك) — جدولٌ يديره المدير لا ثابت.
// يُستعمل لصفة الولي وصفة جهة الطوارئ كلتيهما.
model GuardianRelation {
  id                    String         @id @default(cuid())
  nameAr                String         @unique
  ordinal               Int            @default(0)
  isActive              Boolean        @default(true)
  guardianLinks         GuardianLink[] @relation("GuardianRel")
  emergencyStudents     Student[]      @relation("EmergencyRel")
  applicationsGuardian  Application[]  @relation("AppGuardianRel")
  applicationsEmergency Application[]  @relation("AppEmergencyRel")
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WAITLISTED
}

// نموذج القيد العام (§٦٫١): يُرسَل إلى Route Handler لا إلى Supabase REST.
// لا سياسة anon insert إطلاقًا. nationalIdEnc يُشفَّر قبل أن يمسّ القاعدة.
// سجلٌّ ثابت لا يُحذف عند القبول — أثرٌ لكل من طرق الباب.
model Application {
  id                  String           @id @default(cuid())
  nameAsInId          String
  nationalIdEnc       String // م٥ — مشفَّر على مستوى التطبيق
  nationalityId       String
  nationality         Nationality      @relation(fields: [nationalityId], references: [id])
  birthDate           DateTime
  gender              Gender
  schoolStageId       String?
  schoolStage         SchoolStage?     @relation(fields: [schoolStageId], references: [id])
  guardianPhone       String
  guardianEmail       String? // اختياريّ (الفكرة ٩) — نجمعه من أول مسجَّل للرسالة الأسبوعية لاحقًا
  guardianGender      Gender
  // صفة الولي (أب/أخ/…) — قيمة من GuardianRelation. إلزامية نظيفةً (NOT NULL):
  // نموذج القيد هو نقطة الدخول، فالإلزام يُثبَّت في القاعدة لا في التحقّق وحده.
  guardianRelationId  String
  guardianRelation    GuardianRelation @relation("AppGuardianRel", fields: [guardianRelationId], references: [id])
  studentPhone        String? // اختياري لمن دون ١٣، إلزامي لمن بلغها (يُنفَّذ في التحقّق)
  // جهة اتصال الطوارئ (اسم + جوال + صفة) — إلزامية (NOT NULL).
  emergencyName       String
  emergencyPhone      String
  emergencyRelationId String
  emergencyRelation   GuardianRelation @relation("AppEmergencyRel", fields: [emergencyRelationId], references: [id])
  priorHifzJuz        Int?
  priorHifzNotes      String?
  preferredCircleId   String?

  status       ApplicationStatus @default(PENDING)
  decidedBy    String?
  decidedAt    DateTime?
  decisionNote String? // إلزامي عند الرفض
  studentId    String?           @unique // يُملأ عند القبول
  createdAt    DateTime          @default(now())

  @@index([status, createdAt])
}

// ═══════════════ رسائل وليّ الأمر (الفكرة ٩) ═══════════════
// صندوقٌ داخل المنصّة + قناةٌ بريديّة لاحقاً (emailedAt). بلا FK (نمط الترحيلات المتأخّرة
// الآمن — تُطبَّق معجميًّا). النوع نصّي: WEEKLY (تقرير أسبوعيّ) | ABSENCE_UNEXCUSED (تنبيه غياب).
// منع التكرار بـ(الطالب+النوع+refDate): بداية الأسبوع للأسبوعيّة، ويوم الغياب للتنبيه.
model GuardianMessage {
  id        String    @id @default(cuid())
  studentId String
  kind      String
  refDate   DateTime  @db.Date
  subject   String
  body      String
  createdAt DateTime  @default(now())
  readAt    DateTime?
  emailedAt DateTime? // القناة البريديّة لاحقاً — تُملأ عند الإرسال (بلا إعادة بناء)

  @@unique([studentId, kind, refDate])
  @@index([studentId])
}

// ═══════════════ الاقتصاد — بنود النقاط (م٦أ) ═══════════════
// ECONOMY_RULES.md الركن ١. جدولان بلا FK (نمط الترحيلات المتأخّرة الآمن — تُطبَّق
// معجميًّا، اسم الترحيل «9zzz»). الرصيد **مشتقٌّ** من مجموع الحركات (لا عمود مخزّن):
// الدفتر (PointTransaction) هو مصدر الحقيقة الوحيد، فلا يَشرُد رصيدٌ مخزَّنٌ عن دفتره.
// كلّ البنود تديرها الإدارة (إضافة/تعديل قيمة/تعطيل — لا حذف): active=false تعطيلٌ لا محو.

enum PointGrantSource {
  AUTO // النظام تلقائيًّا عند حدث (الحضور/الاختبار) — مؤجَّلٌ لدفعة م٦أ-٢
  TEACHER // يدويّ من المعلّم (لطلاب حلقته فقط)
  ADMIN // يدويّ من الإدارة
}

enum PointLimitPeriod {
  DAY
  WEEK
  NONE // بلا حدّ
}

// بند نقاطٍ يديره المدير. القيمة موجبة (كسب) أو سالبة (خصم). الحدّ = عدد/فترة لكلّ بند.
model PointItem {
  id          String           @id @default(cuid())
  nameAr      String
  value       Int // موجب = كسب، سالب = خصم
  grantSource PointGrantSource
  limitCount  Int? // عدد مرّات المنح المسموح بها في الفترة (null/الفترة NONE = بلا حدّ)
  limitPeriod PointLimitPeriod @default(NONE)
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
}

// حركةٌ في دفتر النقاط — سطرٌ لكلّ عملية منحٍ/خصم. amount وgrantSource **لقطتان تاريخيّتان**
// وقت المنح، فلا يُعيد تعديلُ البند لاحقًا كتابةَ الماضي. الرصيد = SUM(amount) لكلّ طالب.
model PointTransaction {
  id              String           @id @default(cuid())
  studentId       String
  pointItemId     String
  amount          Int // = قيمة البند وقت المنح (موقّعة)
  grantSource     PointGrantSource // مصدر المنح وقت العملية
  grantedByUserId String? // من منحها (null لمنح النظام لاحقًا في م٦أ-٢)
  note            String?
  createdAt       DateTime         @default(now())

  @@index([studentId])
  @@index([pointItemId])
}

// ═══════════════ الاقتصاد — الربط التلقائيّ (م٦أ-٢) ═══════════════
// ECONOMY_RULES.md الركن ١ (تفعيل AUTO). الإدارة تربط بنداً مصدره AUTO بنوع حدثٍ من قائمةٍ
// ثابتة؛ عند وقوع الحدث يمنح النظام البند تلقائياً عبر منطق م٦أ نفسه (PointTransaction،
// grantSource=AUTO، grantedByUserId=null). جدولان بلا FK (نمط الترحيلات المتأخّرة الآمن).

// أنواع الأحداث المدعومة للربط التلقائيّ (قائمةٌ ثابتة — لا تُدار من الشاشة). خمسةٌ فقط.
enum AutoEventType {
  ATTENDANCE // خامدٌ (م ب): استُبدل بالحالات المفصّلة أدناه — يبقى للربط القديم إن وُجد
  HIZB_EXAM_PASS // اجتياز الحزب (انتقاله التلقائيّ بحصاده — الحكم ٧)
  STAGE_EXAM_PASS // اجتياز اختبار المرحلة الأصلية
  DAILY_HARVEST // إتمام الحصاد اليوميّ
  PROMOTION // ترقية/انتقال المرحلة الأصلية (باعتماد المدير)
  QAIDAH_COMPLETE // إتمام القاعدة المدنية (كلّ الدروس) — تخرّجٌ من القاعدة
  // ── حالات الحضور المفصّلة (م ب — شاشة التشغيل الموحّدة). «مستأذن» = لا حدث (صفر). ──
  ATTENDANCE_PRESENT // حاضر
  ATTENDANCE_LATE // متأخّر
  ATTENDANCE_ABSENT // غائب
  ATTENDANCE_LEFT_NO_PERMISSION // خرج بدون إذن
  // ── المهامّ اليوميّة الثلاث: تمّ/لم يتمّ ──
  HIFZ_DONE
  HIFZ_MISSED
  TARSEEKH_DONE
  TARSEEKH_MISSED
  MURAJAAH_DONE
  MURAJAAH_MISSED
  // ── الإنجاز الزائد (زرّ «+زيادة» في الشاشة الموحّدة — م ج) ──
  HIFZ_EXTRA
  TARSEEKH_EXTRA
  MURAJAAH_EXTRA
  // ── دروس القاعدة المدنية (م ج — الشاشة الموحّدة): متقن/غير متقن ──
  QAIDAH_LESSON_MASTERED
  QAIDAH_LESSON_NOT_MASTERED
  // ── المُدَّكِر: تُطلَق عند تأكيد المشرف الانتظام الأسبوعيّ (نقاطٌ معلّقة — §٧) ──
  MUDDAKIR_DAY_COMPLETE
  MUDDAKIR_FACE_HEARD
  MUDDAKIR_STAGE_COMPLETE
  MUDDAKIR_SHORTFALL
}

// قاعدةٌ تربط بنداً (PointItem مصدره AUTO) بنوع حدث. الإدارة تنشئها من شاشة النقاط.
// بندٌ واحدٌ ← قاعدةٌ واحدة (@@unique). ويُضمَن حدَثٌ واحدٌ لبندٍ مفعّلٍ واحدٍ في طبقة الخادم.
// active يُرافق تفعيل/تعطيل البند (مرآةٌ في economy.ts) ليَسهُل على grantAuto اختيار القاعدة.
model AutoGrantRule {
  id          String        @id @default(cuid())
  pointItemId String        @unique
  eventType   AutoEventType
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())

  @@index([eventType, active])
}

// دفتر منعِ الازدواج: سطرٌ لكلّ منحٍ تلقائيّ فعليّ. القيد الفريد (نوع الحدث + المرجع +
// الطالب) يمنع منح الحدث الواحد مرّتين ولو أُعيد تسجيله. يرتبط بحركة الدفتر التي أنشأها.
model AutoGrant {
  id                 String        @id @default(cuid())
  eventType          AutoEventType
  sourceRef          String // معرّف الحدث/السجلّ الأصليّ (سجلّ الحضور/الاختبار/الحصاد/الانتقال)
  studentId          String
  pointTransactionId String
  reversedAt         DateTime? // عُكِس (حدثٌ متنافٍ أحدث في اليوم نفسه) — يقابله قيدٌ تعويضيّ في الدفتر
  reversedById       String? // الفاعل الذي سبّب العكس (منح الحالة الجديدة)
  createdAt          DateTime      @default(now())

  // منع الازدواج: فهرسٌ فريدٌ **جزئيّ** على (الحدث+المرجع+الطالب) WHERE "reversedAt" IS NULL —
  // يُنشأ في الترحيل بـSQL خام (Prisma لا يعبّر عن الفهارس الجزئيّة). المعكوس لا يمنع إعادة المنح.
  @@index([eventType, sourceRef, studentId])
  @@index([studentId])
}

// ═══════════════ الاقتصاد — السوق الحقيقيّ بالكود (م٦ب) ═══════════════
// ECONOMY_RULES.md الركن ٢. ثلاثة جداول بلا FK (نمط الترحيلات المتأخّرة الآمن — تُطبَّق
// معجميًّا، اسم الترحيل «9zzzzz_market» يقع بعد «9zzzz_user_management»). الخصم **لا رصيد
// منفصل**: يُنشئ حركةً سالبةً في دفتر م٦أ نفسه (PointTransaction)، فالرصيد يبقى SUM(amount).
// «البائع» صلاحيّةٌ مستقلّة (Role.SELLER) تُمنح عبر إدارة المستخدمين القائمة.

// حالة اعتماد الثمرة (م٦ب-٢): ثمرات الإدارة APPROVED افتراضًا، وثمرة الوليّ تبدأ PENDING.
enum MarketItemApproval {
  APPROVED
  PENDING
  REJECTED
}

// سلعةٌ حقيقيّة تديرها الإدارة (إضافة/تعديل/تعطيل — لا حذف). السعر بالنقاط موجبٌ.
// stock=null ⟵ بلا حدّ مخزون؛ عددٌ ⟵ يُنقَص عند كلّ بيع، والصفر يمنع البيع.
// م٦ب-٢ (هدايا وليّ الأمر): حقولٌ تُضاف بقيمٍ افتراضيّة لا تكسر الثمرات القائمة —
// addedByUserId=null (الإدارة) · targetStudentId=null (عامّة) · approvalStatus=APPROVED
// (معروضة) · proposedPricePoints=null. الحقول بلا FK (نمط جداول الاقتصاد المتأخّرة).
model MarketItem {
  id          String   @id @default(cuid())
  nameAr      String
  imageUrl    String?
  pricePoints Int // سعرٌ بالنقاط — موجبٌ دومًا (القيمة المثبّتة للجَنْي)
  stock       Int? // null = بلا حدّ
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  // ── م٦ب-٢ ──
  addedByUserId       String? // مَن أضافها (null = الإدارة)
  targetStudentId     String? // خاصّةٌ بطالبٍ (null = عامّة)
  approvalStatus      MarketItemApproval @default(APPROVED) // ثمرة الوليّ تبدأ PENDING
  proposedPricePoints Int? // قيمة الوليّ المقترحة (الإدارة تعتمدها/تعدّلها)

  @@index([approvalStatus])
  @@index([targetStudentId])
}

// كود الطالب المتغيّر اللحظيّ (ECONOMY_RULES §الركن ٢): يطلبه الطالب أو وليّه، فيُولَّد
// كودٌ قصيرٌ عشوائيّ (~٦ خانات، أبجديّةٌ غير ملتبسة) يُعرَض كـQR ورقمٍ احتياطيّ، وينتهي
// بعد ~٥ دقائق (expiresAt)، ويُستعمل مرّةً واحدة (usedAt). الكود نفسه هو حمولة الـQR.
model StudentCode {
  id        String    @id @default(cuid())
  studentId String
  code      String    @unique // قصيرٌ عشوائيّ — للمسح والإدخال اليدويّ كليهما
  expiresAt DateTime
  usedAt    DateTime? // null = لم يُستعمل بعد
  createdAt DateTime  @default(now())

  @@index([studentId])
}

// عمليّة شراء: لقطةٌ تاريخيّة للسعر (pricePaid) + البائع + ربطٌ بحركة الخصم في دفتر م٦أ.
// pointTransactionId يوثّق أنّ الخصم وقع فعلًا في الدفتر الموحّد (لا رصيد منفصل).
model Purchase {
  id                 String   @id @default(cuid())
  studentId          String
  marketItemId       String
  pricePaid          Int // لقطة السعر وقت البيع
  sellerUserId       String // البائع (Role.SELLER) الذي أجرى العمليّة
  pointTransactionId String? // حركة الخصم السالبة في دفتر م٦أ
  createdAt          DateTime @default(now())

  @@index([studentId])
  @@index([sellerUserId])
}

// ═══════════════ إدارة المستخدمين (المرحلة أ) — ROLES.md ═══════════════
// رابط تفعيلٍ لمرّةٍ واحدة: يُنشأ عند إضافة كادرٍ (ACTIVATE) أو إعادة تعيين (RESET)،
// يُسلَّم للمعلّم فيضبط كلمة سرّه في Supabase Auth. usedAt يبطله، وينتهي بعد ٧ أيّام.
// بلا FK (نمط الترحيلات المتأخّرة الآمن — تُطبَّق معجميًّا، اسم «9zzzz»).

enum ActivationPurpose {
  ACTIVATE
  RESET
}

model ActivationLink {
  id              String            @id @default(cuid())
  userId          String
  token           String            @unique // عشوائيّ قويّ — لا يُخمَّن
  purpose         ActivationPurpose
  expiresAt       DateTime
  usedAt          DateTime? // null = لم يُستعمل بعد
  createdByUserId String? // من أنشأه (كادر الإدارة)
  createdAt       DateTime          @default(now())

  @@index([userId])
}

// ═══════════════ الأحداث (م١) ═══════════════
// قاعدة العمل ٥: كل تغيير حالة يُصدِر حدثًا. سجلٌّ ملحق (append-only) يستهلكه
// الاقتصاد لاحقًا بلا هجرة (م٦: points.source_event). النوع نصّي عمدًا — تيّارُ
// أحداثٍ مفتوح لا enum مغلق يُقيّده كل استعمال جديد.
model Event {
  id             String   @id @default(cuid())
  type           String // مثال: STUDENT_ACCEPTED, APPROVAL_DECIDED
  subjectType    String // Student | Approval | GuardianLink | ...
  subjectId      String
  actorId        String? // من أحدث التغيير (الفاعل الفعليّ؛ المنتحَل أثناء انتحال). null لأحداث النظام
  impersonatorId String? // الفاعل الحقيقيّ (المدير التقنيّ) حين يقع الفعل أثناء انتحال الشخصيّة. null في الأصل
  payload        Json?
  createdAt      DateTime @default(now())

  @@index([subjectType, subjectId])
  @@index([type, createdAt])
  @@index([impersonatorId])
}

// ═══════════════ المُدَّكِر — نموذج البيانات (المرحلة ١) ═══════════════
// MUDDAKIR_RULES.md هو الحاكم. جداولٌ ملحقةٌ بلا FK (نمط الترحيلات المتأخّرة الآمن): المعرّفات
// (studentId/supervisorId/…) نصّيّةٌ مرجعيّة، ولا تمسّ جداول الطلاب القائمة. يُشتقّ MuddakirDay
// من MuddakirEvent (مزامنة PWA idempotent). قيم الإعدادات ⚙ في جدول Setting (programId=prog_muddakir).

enum MuddakirMode {
  ACTIVE // يحفظ ويربط ويراجع ويعالج
  REVIEW_ONLY // واقفٌ عند مرحلة: ربط/مراجعة/علاج بلا جديد (§١)
}

enum MuddakirDeliveryMode {
  IN_PERSON // اللقاء حضوريّ
  REMOTE // اللقاء مرئيّ عن بُعد (§٦)
}

enum MuddakirFaceState {
  NEW
  IN_RIBAT
  HEARD
  IN_REVIEW
}

enum MuddakirDayStatus {
  OPEN // اليوم جارٍ — الحالة الابتدائيّة قبل الإتمام/القضاء
  COMPLETE
  PENDING_MAKEUP
  MADE_UP
  SHORTFALL
  EXCUSED
}

enum MuddakirExcuseReason {
  ILLNESS
  TRAVEL
  EXAMS
}

enum MuddakirErrorSource {
  RIBAT
  REVIEW
  SUPERVISOR
  EXAMINER // موضعٌ سجّله المختبِر في سرد المرحلة (§٤٫٤/§٧)
}

enum MuddakirRecitationKind {
  STAGE // سرد مرحلةٍ (١..٦)
  FINAL // السرد الختاميّ بعد المرحلة السادسة (§١ التخرّج)
  TATHBIT_FINAL // السرد الختاميّ لمرحلة التثبيت بعد الدرجة العاشرة (§١٢)
}

// طور الحافظ (§١/§١٢): الحفظ (المراحل الستّ) ثمّ التثبيت (درجاته) ثمّ الورد الدائم مدى الحياة.
enum MuddakirPhase {
  MEMORIZE // في مراحل الحفظ الستّ
  TATHBIT // في درجات التثبيت
  PERMANENT // الورد الدائم بعد شهادة التثبيت
}

// أدوار المدّكر المُحصَّرة (§٢): إسنادٌ خاصٌّ بالبرنامج، لا دورٌ عامٌّ في Role (لا يفتح شيئاً في
// مراقي). مدير المنصّة يُسند MANAGER؛ ومدير البرنامج يُسند الباقي (والإداريّ بطلب).
enum MuddakirStaffRole {
  MANAGER // مدير البرنامج
  ADMIN // الإداريّ (إجراءاته بطلبٍ يعتمده المدير)
  SUPERVISOR // مشرفٌ في المدّكر (نظير ARIF، محصورٌ بالبرنامج)
  EXAMINER // مختبِرٌ في المدّكر (نظير RECITER، محصورٌ بالبرنامج)
}

// طلبات الإداريّ (§٢): كلّ إجراءٍ يغيّر شيئاً يُنشئه الإداريّ طلباً معلّقاً يعتمده مدير البرنامج.
enum MuddakirRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED // ألغاه صاحبه قبل البتّ
}

enum MuddakirRequestType {
  ENROLL // إلحاق حافظ
  ASSIGN_SUPERVISOR // إسناد مشرف
  SET_MODE // الوقوف عند مرحلة / استئناف
  SET_SETTING // ضبط إعدادٍ (§٩)
  SET_TATHBIT_LADDER // سلّم التثبيت
  SET_POINT_ITEM // بند نقاطٍ خاصٌّ بالمدّكر (AUTO لأحداث MUDDAKIR_*)
}

// وضع الحافظ ومساره ودورة مراجعته (§١، §٤). صفٌّ لكلّ حافظ.
model MuddakirProfile {
  id              String               @id @default(cuid())
  studentId       String               @unique
  track           Int // ١ | ٢ | ٣ أوجه/يوم
  pendingTrack    Int? // تغيير مسارٍ يُطبَّق من اليوم التالي
  effectiveFrom   DateTime?            @db.Date
  reviewCycleDays Int                  @default(7) // يعدّلها المشرف لكلّ حافظ
  currentStageId  String?
  mode            MuddakirMode         @default(ACTIVE)
  deliveryMode    MuddakirDeliveryMode @default(IN_PERSON)
  // مرحلة التثبيت (§١٢): الطور، والدرجة الحاليّة، وترتيب الختمة داخلها، ومؤشّر الورد (عدد الأوراد
  // المُتمّة = موضعه في الجدول)، وعدّاد الختمات التراكميّ مدى الحياة.
  phase             MuddakirPhase @default(MEMORIZE)
  tathbitDegree     Int? // درجة التثبيت الحاليّة (١..١٠)، أو null قبل التثبيت
  khatmaInDegree    Int           @default(0) // عدد ختمات الدرجة الحاليّة المُتمّة
  wardsCompleted    Int           @default(0) // مؤشّر الورد: عدد الأوراد المُتمّة (موضعه في الجدول)
  wardsRaised       Int           @default(0) // إزاحةُ الرفع المبكّر (أوراد قفزها المشرف بلا إتمام، §١٢)
  cumulativeKhatmat Int           @default(0) // عدّاد الختمات التراكميّ (مدى الحياة)
}

// حالة كلّ وجهٍ (صفحة) لكلّ حافظ (§٤٫٢). جوهر التقدّم.
model MuddakirFace {
  id               String            @id @default(cuid())
  studentId        String
  page             Int // ١..٦٠٤ (= وجه)
  state            MuddakirFaceState @default(NEW)
  weak             Boolean           @default(false)
  repErrors        Int               @default(0) // تراكميّ طوال العمر — مؤشّر قوّةٍ للمشرف
  firstMemorizedOn DateTime?         @db.Date
  heardAt          DateTime?
  heardById        String?
  reviewEnteredOn  DateTime?         @db.Date

  @@unique([studentId, page])
  @@index([studentId, state])
}

// يوم الحافظ — مُشتقٌّ من MuddakirEvent (إسقاطٌ ماديّ، ليس مصدراً مستقلّاً). §٣، §٥.
model MuddakirDay {
  id             String                @id @default(cuid())
  studentId      String
  dayDate        DateTime              @db.Date // بتوقيت مكّة (يُحسب في الخادم)
  status         MuddakirDayStatus     @default(OPEN)
  newFromPage    Int? // الوحدة في المدّكر صفحة (وجه): نطاق الجديد بالصفحات
  newToPage      Int?
  ribatDone      Boolean?
  reviewDone     Boolean?
  excuseReason   MuddakirExcuseReason?
  completedAt    DateTime?
  makeupForDayId String? // يربط يوم القضاء بيومه (§٥)

  @@unique([studentId, dayDate])
  @@index([studentId, status])
}

// عدّاد كلّ وجهٍ في يومٍ (يلزمه مسارا ٢/٣ أوجه) (§٤٫١).
model MuddakirDayFace {
  id            String @id @default(cuid())
  dayId         String
  page          Int
  reps          Int    @default(0) // تكرار الجديد (افتراض ٣٠)
  repErrors     Int    @default(0) // ضغطات «أخطأت» في هذا اليوم
  yesterdayReps Int    @default(0) // تكرار الأمس (افتراض ١٠)

  @@unique([dayId, page])
  @@index([dayId])
}

// موضع خطأٍ مفتوحٍ للعلاج (§٤٫٤): صفحة + سطر (من MushafLine) + مصدر.
model MuddakirError {
  id                 String              @id @default(cuid())
  studentId          String
  page               Int
  lineNo             Int // مرجع MushafLine (page, lineNo)
  source             MuddakirErrorSource
  openedOn           DateTime            @db.Date
  cleanSessions      Int                 @default(0) // جلساتٌ سليمةٌ متتالية
  lastCleanSessionOn DateTime?           @db.Date // لحساب التتابع
  resolvedAt         DateTime?
  recordedById       String?

  @@index([studentId, resolvedAt])
  @@index([studentId, page, lineNo])
}

// أسبوع الحافظ (§٦): تأكيد الانتظام يُطلق النقاط المعلّقة (§٧).
model MuddakirWeek {
  id                    String    @id @default(cuid())
  studentId             String
  weekStart             DateTime  @db.Date
  heardCount            Int       @default(0)
  regularityConfirmedAt DateTime?
  confirmedById         String?

  @@unique([studentId, weekStart])
}

// إسناد الحافظ↔المشرف (§٢): سقف ٤ حفّاظ نشطين للمشرف (يُفرَض في الخادم والواجهة).
// المشرف = حافظٌ متقدّم بدور ARIF داخليّاً، يُعرض «المشرف». قيد «نشطٌ واحدٌ لكلّ حافظ» =
// فهرسٌ فريدٌ جزئيّ WHERE "endedAt" IS NULL يُنشأ في الترحيل بـSQL خام (نمط AutoGrant).
model MuddakirSupervision {
  id           String    @id @default(cuid())
  studentId    String
  supervisorId String
  startedAt    DateTime  @default(now())
  endedAt      DateTime?

  @@index([studentId, endedAt])
  @@index([supervisorId, endedAt])
}

// إسناد أدوار المدّكر (§٢): مَن عُيّن بأيّ دورٍ ومَن عيّنه ومتى. append-only، والإنهاء بـendedAt
// (لا حذف). المستخدم قد يحمل أكثر من دور. بلا FK (نمط الجداول المتأخّرة الآمن).
model MuddakirStaff {
  id         String           @id @default(cuid())
  userId     String
  role       MuddakirStaffRole
  assignedBy String // مَن عيّنه (مدير المنصّة للـMANAGER، ومدير البرنامج للباقي)
  startedAt  DateTime         @default(now())
  endedAt    DateTime? // الإنهاء (لا حذف) — النشط = null

  @@index([userId, endedAt])
  @@index([role, endedAt])
}

// طلبات الإداريّ (§٢): append-only. عند الموافقة يُنفَّذ بالدالّة نفسها التي ينفّذها المدير مباشرة
// (executeRequest) داخل معاملة، مرّةً واحدة (executedAt). الرفض بسبب. الإلغاء لصاحبه قبل البتّ.
model MuddakirAdminRequest {
  id             String                @id @default(cuid())
  type           MuddakirRequestType
  payload        Json // بيان الإجراء (نفس وسائط دالّة المدير)
  studentId      String? // الحافظ المعنيّ إن وُجد (للعرض/الفهرسة)
  requestedBy    String
  requestedAt    DateTime              @default(now())
  status         MuddakirRequestStatus @default(PENDING)
  decisionReason String? // إلزاميٌّ عند الرفض
  decidedBy      String?
  decidedAt      DateTime?
  executedAt     DateTime? // لحظة التنفيذ عند الموافقة (ضمانُ ألا يُنفَّذ مرّتين)

  @@index([status])
  @@index([requestedBy, status])
}

// سجلّ أحداث المزامنة (PWA) الملحق — مصدر الحقيقة؛ يُشتقّ منه MuddakirDay/DayFace.
// clientEventId يولّده الجهاز فيكون الإرسال idempotent (بلا ازدواجٍ ولا ضياع). §٨.
model MuddakirEvent {
  id            String   @id @default(cuid())
  clientEventId String   @unique
  studentId     String
  dayDate       DateTime @db.Date
  type          String
  payload       Json?
  occurredAt    DateTime // وقت الجهاز
  receivedAt    DateTime @default(now())

  @@index([studentId, dayDate])
}

// سرد المرحلة والسرد الختاميّ (§١/§٧): المختبِر (RECITER) يسجّل النتيجة، ومواضع الأخطاء تدخل
// علاج الأخطاء بمصدر EXAMINER. الاجتياز يُصدِر شهادةً وينقل المرحلة، ونقاط MUDDAKIR_STAGE_COMPLETE
// تُضاف لدفعة تأكيد الأسبوع (recitedOn ضمن النافذة). بلا FK (نمط الجداول المتأخّرة الآمن).
model MuddakirRecitation {
  id            String                 @id @default(cuid())
  studentId     String
  kind          MuddakirRecitationKind @default(STAGE)
  stage         Int // رقم المرحلة ١..٦
  passed        Boolean
  examinerId    String // المختبِر (RECITER)
  certificateId String? // الشهادة الصادرة عند الاجتياز
  recitedOn     DateTime               @db.Date // يوم السرد بتوقيت مكّة (لدفعة الأسبوع)
  createdAt     DateTime               @default(now())

  @@index([studentId])
  @@index([studentId, recitedOn])
}

// سلّم التثبيت (§١٢): درجاتٌ يحرّرها المدير (بياناتٌ لا ثوابت). عدد ختمات الدرجة = عدد أجزائها
// اليوميّة (من الثانية فصاعداً)، والأولى ٣. يُبذَر بالعشر درجات من جدول §١٢ ويُعدَّل من الإدارة.
model MuddakirTathbitDegree {
  degreeNo   Int     @id // ١..١٠ (ترتيب الدرجة)
  dailyJuz   Int // أجزاء الورد اليوميّ
  khatmaDays Int // أيّام الختمة (⌈٣٠ ÷ dailyJuz⌉)
  khatmaCount Int // عدد ختمات الدرجة
  active     Boolean @default(true)
}

// إسقاطُ يوم الورد في التثبيت/الدائم (نظير MuddakirDay، §٣/§٥/§١٢). يُعاد اشتقاقه من الأحداث.
// الحالة من MuddakirDayStatus نفسها. بلا FK (نمط الجداول المتأخّرة الآمن).
model MuddakirWardDay {
  id             String            @id @default(cuid())
  studentId      String
  dayDate        DateTime          @db.Date // بتوقيت مكّة
  phase          MuddakirPhase // TATHBIT | PERMANENT
  degreeNo       Int // درجة التثبيت وقتها (أو قيمة الورد الدائم)
  khatmaNo       Int // ترتيب الختمة التراكميّ وقتها
  status         MuddakirDayStatus @default(OPEN)
  wardsCompleted Int               @default(0) // أوراد أُتمّت في هذا اليوم (٠..٢: الفائت + ورد اليوم)
  makeupForDate  DateTime?         @db.Date // اليوم الفائت الذي عُوِّض فيه

  @@unique([studentId, dayDate])
  @@index([studentId, status])
}

// سجلّ الرفع المبكّر لدرجةٍ (§١٢): append-only، يراه المدير. لا نزول آليّ ولا حذف.
model MuddakirDegreeRaise {
  id           String   @id @default(cuid())
  studentId    String
  fromDegree   Int
  toDegree     Int
  atKhatma     Int // ترتيب الختمة التي رُفع عندها
  bySupervisorId String
  createdAt    DateTime @default(now())

  @@index([studentId])
}

// ═══════════════ التلعيب (GAMIFICATION_RULES.md) ═══════════════
// الأوسمة: تعريفاتٌ يحرّرها المدير من قائمة شروطٍ معرَّفة (BadgeConditionKind)، ومنحٌ append-only
// يُمنح مرّةً واحدة لكلّ (طالب، تعريف) — بلا سحبٍ بعد المنح (§٥). النقاط والسلسلة مشتركتان: النقاط
// من الحصاد القائم (PointTransaction)، والسلسلة محسوبةٌ من حالات الأيّام القائمة لا مخزّنة.

enum BadgeConditionKind {
  STREAK_DAYS // الانتظام: threshold = عدد الأيّام
  STAGE_COMPLETE // إتمام مرحلة
  TRACK_OR_DEGREE_COMPLETE // إتمام مسار/درجة
  HIFZ_KHATM // ختم الحفظ
  TATHBIT_CERTIFICATE // شهادة التثبيت
  WEEK_NO_ERROR // أسبوع بلا خطأ
  STAGE_RECITATION_NO_ERROR // سرد مرحلة بلا خطأ
  FACES_HEARD_NO_ERROR // threshold = عدد الأوجه المسموعة بلا خطأ
  FIRST_DAY // أوّل يوم
  FIRST_WEEK_COMPLETE // أوّل أسبوعٍ مكتمل
}

enum BadgeCategory {
  REGULARITY // الانتظام 🔥
  ACHIEVEMENT // الإنجاز 🏅
  MASTERY // الإتقان ✨
  ONBOARDING // البداية 🌱
}

// تعريف الوسام — يحرّره المدير (الاسم/الوصف/التفعيل/العتبة) من القائمة المعرَّفة، لا شرطٌ حرّ.
model BadgeDefinition {
  id        String             @id @default(cuid())
  code      String             @unique // مُعرّفٌ ثابتٌ للبذر (STREAK_7, STAGE_COMPLETE, …)
  kind      BadgeConditionKind
  threshold Int? // لِـSTREAK_DAYS و FACES_HEARD_NO_ERROR
  category  BadgeCategory
  nameAr    String
  descAr    String
  emoji     String?
  active    Boolean            @default(true)
  sortOrder Int                @default(0)
  createdAt DateTime           @default(now())

  @@index([kind, active])
}

// منح الوسام — append-only، مرّةً واحدة لكلّ (طالب، تعريف). لا سحب (§٥)؛ التصحيح بقيدٍ لا بحذف.
model BadgeGrant {
  id          String   @id @default(cuid())
  studentId   String
  badgeDefId  String
  earnedAt    DateTime @default(now())
  sourceEvent String // الحدث الذي منحه (للتوثيق)
  sourceRef   String?

  @@unique([studentId, badgeDefId])
  @@index([studentId])
}

// قوالب رسائل التحفيز (GAMIFICATION_RULES §٦): نوعٌ معرَّف ونصٌّ عربيٌّ يحرّره المدير بمتغيّرات {…}.
enum MotivationKind {
  STREAK_AT_RISK // {days}
  FIRST_STEP
  BADGE_NEAR // {remaining} {badge}
  STATION_PROGRESS // {done} {total} {station}
}

model MotivationTemplate {
  id        String         @id @default(cuid())
  kind      MotivationKind @unique
  textAr    String // قالبٌ بمتغيّراته {…}
  active    Boolean        @default(true)
  updatedAt DateTime       @updatedAt
}
