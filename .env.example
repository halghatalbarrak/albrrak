# ═══════════════════════════════════════════════════════════════════
#  نموذج متغيّرات البيئة — أسماء فقط بلا قيم.
#  انسخه إلى .env واملأ القيم من جهازك. لا تُرفع .env إلى git أبدًا.
# ═══════════════════════════════════════════════════════════════════

# ── قاعدة البيانات (Prisma ⟵ Supabase Postgres) ──────────────────────
# سلسلة الاتصال المجمّعة (Transaction Pooler, port 6543) — لتشغيل التطبيق.
DATABASE_URL=

# اتصال مباشر (Session, port 5432) — لترحيلات Prisma (migrate deploy).
DIRECT_URL=

# ── Supabase — مفاتيح عامة (مصمَّمة لتكون عامة؛ الأمان في RLS لا في إخفائها) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── تشفير رقم الهوية (م٥) — سرّي جدًّا ──
# مفتاح AES-256: ٣٢ بايت بترميز base64. ولّده مرّة: openssl rand -base64 32
# فقدانه = تعذّر فكّ تشفير أرقام الهوية المخزَّنة. لا يُرفع أبدًا.
NATIONAL_ID_ENC_KEY=
